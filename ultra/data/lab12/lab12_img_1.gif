    <IFRAME src="/includes/stayalive.jsp"  frameBorder=0 height=0 marginHeight=0 marginWidth=0 width=0></IFRAME>
    
    <footer id="cgfooter" style="min-height: 70px; width: 100%; padding: 15px;position: relative;bottom: 0;" class="">
      <div class="container text-center">
       
              
      </div>
    </footer>
    <script>
          
        
        $(window).resize(function (){           
           cgfooterByResize();
        });
        function cgfooterByResize() {
           
            var cgclientNAVHeight = 60;
            var cgclientNAV = document.getElementById('cgclientNAV');
            if (typeof(cgclientNAV) != 'undefined' && cgclientNAV != null) {  
                cgclientNAVHeight = document.getElementById('cgclientNAV').clientHeight;
            }
            
            var cgcontainerID =  document.getElementById('cgcontainerID');
            if (typeof(cgcontainerID) != 'undefined' && cgcontainerID != null) {                
                var cgPageBodyHeight = document.getElementById('cgcontainerID').clientHeight;
                var cgFooterHeight = document.getElementById('cgfooter').clientHeight;   
                
                var winMinHeight =  window.innerHeight - cgFooterHeight - cgclientNAVHeight - 10;
               
                
                $("#cgcontainerID").attr('style', "min-height:" + winMinHeight + "px");
                if(cgPageBodyHeight < winMinHeight){ 
                    $("#cgfooter").css("position","fixed");                           
                }else{
                    $("#cgfooter").css("position","relative");          
                }                
            }    
        }  
        
        $(document).ready(function(){            
           cgfooterByResize();
        });     
        
    </script>
    

    










<script>
    function CGcheckOnline() {
        setTimeout("doOnlineCheck()", 50000);
    }
    
    function doOnlineCheck() {
        
        $.ajax({
            url: "/includes/cgkeepalive.jsp",
            data:{userid:"25118"},
            type:"POST",
            dataType:"text",
            timeout:20000,
            success: function(msg) {
                var retMsg = msg.trim();
                if(retMsg === "null") {
                    alert("与服务器的会话超时，请退出重新登录！");
                } else if(retMsg === "false") {
                    alert("用户ID发生变化，请检查是否使用其他账号登录本机！");
                }
                CGcheckOnline();
            },
            error: function(XMLHttpRequest, textStatus, erroThrown) {
                console.log(XMLHttpRequest.status);
                if(XMLHttpRequest.status != 404) {
                    alert("可能由于网络问题与服务器的连接断开，请尝试退出重新登录！");
                    CGcheckOnline();
                }                
            }
        });
    }
    
    $(document).ready(function () {
        //Increment the idle time counter every minute.
        CGcheckOnline();
    });

    
</script>
    




