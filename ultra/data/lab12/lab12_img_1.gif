<script>
    function cgOpenUploadImage(imgID) {
        var viewer = new Viewer(document.getElementById(imgID), {
          hidden: function () {
            viewer.destroy();
          },
          title: 0,
        });
        // image.click();
        viewer.show();
    }

    function cgClozeUploadImg(thisobj, maxHeight, answerInputID, answerImgID){
       
        var file = thisobj.files[0];

        if(file.type.indexOf('image')<0){
            alert("请确保文件为图像类型");
            return false;
        }
        var reader = new FileReader();
        reader.readAsDataURL(file);
        reader.onload = function(e){
           
            cgClozeUploadResizedImage(this.result, 1000, maxHeight * 700, answerInputID, answerImgID);
        }
                
    }
    
    function cgClozeUploadResizedImage(datas, MAX_WIDTH, MAX_HEIGHT, answerInputID, answerImgID) {
        // We create an image to receive the Data URI
        var img = document.createElement('img');

        // When the event "onload" is triggered we can resize the image.
        img.onload = function()
            {        
                // We create a canvas and get its context.
                var canvas = document.createElement('canvas');
                var ctx = canvas.getContext('2d');

                var width = img.width;
                var height = img.height;

                var newDataUri = 0;
                for(var cutNum = 0; cutNum < 32; cutNum++) {
                    
                    if (height > MAX_HEIGHT) {
                        width *= MAX_HEIGHT / height;
                        height = MAX_HEIGHT;
                    }
                    
                    // We set the dimensions at the wanted size.
                    canvas.width = width;
                    canvas.height = height;
                    
                    console.log(height);

                    // We resize the image with the canvas method drawImage();
                    ctx.drawImage(this, 0, 0, width, height);

                    newDataUri = canvas.toDataURL('image/jpeg', 0.75);

                    if(newDataUri.length > 500000) {
                        MAX_WIDTH = MAX_WIDTH - 1;
                        MAX_HEIGHT = MAX_HEIGHT - 1;

                        width = img.width;
                        height = img.height;
                    } else {
                        break;
                    }
                }
                if(newDataUri.length > 500000) {
                    alert("原图太大了！请将图片大小缩小至1MB以下，或者调低拍照的分辨率。");
                    return;
                } 
                document.getElementById(answerInputID).value=newDataUri;
                document.getElementById(answerImgID).src=newDataUri;
                
                var clozeFormID = $('#' + answerInputID).closest('form').attr('id');
                var clozeFormObj = document.getElementById(clozeFormID);
                
                clozeFormObj.doAutoSubmit.value = "false";
                clozeFormObj.submit();
            };

        // We put the Data URI in the image's src attribute
        img.src = datas;
    }
    
    function cgClozeInput(formobj) {
        formobj.doAutoSubmit.value = "true";
        
        formobj.submit();
    }
    function cgClozeChange(formobj) {
        formobj.doAutoSubmit.value = "false";
        formobj.submit();
    }
</script>
